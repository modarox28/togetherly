{
  "manifest_version": 3,
  "name": "Togetherly Sync",
  "version": "2.4.3",
  "description": "Mira Netflix, Prime Video, HBO Max, Disney+ y más en sincronía con quien quieras, estén donde estén.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/dp/*",
        "https://www.disneyplus.com/*",
        "https://play.hbomax.com/*",
        "https://www.hbomax.com/*",
        "https://play.max.com/*",
        "https://www.max.com/*",
        "https://tv.apple.com/*",
        "https://www.paramountplus.com/*",
        "https://disneyplus.com/*",
        "https://*.disneyplus.com/*",
        "https://netflix.com/*",
        "https://primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://hbomax.com/*",
        "https://max.com/*",
        "https://paramountplus.com/*"
      ],
      "js": [
        "platforms.js",
        "content.js",
        "chat-panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*",
        "https://crunchyroll.com/*"
      ],
      "js": [
        "platforms.js",
        "content.js",
        "chat-panel.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://*.disneyplus.com/*"
      ],
      "js": [
        "disney-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://togetherly-weld.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Togetherly Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
