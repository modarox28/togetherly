{
  "manifest_version": 3,
  "name": "Togetherly Sync",
  "version": "2.0.0",
  "description": "Mira Netflix, Prime Video, HBO Max, Disney+ y más en sincronía con quien quieras, estén donde estén.",
  "minimum_chrome_version": "111",

  "permissions": ["storage"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/dp/*",
        "https://www.disneyplus.com/*",
        "https://play.hbomax.com/*",
        "https://www.hbomax.com/*",
        "https://play.max.com/*",
        "https://www.max.com/*",
        "https://tv.apple.com/*",
        "https://www.paramountplus.com/*"
      ],
      "js": ["plataformas.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.crunchyroll.com/*", "https://static.crunchyroll.com/*"],
      "js": ["plataformas.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://togetherly-weld.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Togetherly Sync"
  }
}
