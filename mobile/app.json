{
  "expo": {
    "name": "Togetherly",
    "slug": "togetherly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "togetherly",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.togetherly.app"
    },
    "android": {
      "package": "com.togetherly.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2A2140"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "owner": "m0d4r0xs-team",
    "extra": {
      "eas": {
        "projectId": "94634693-d94a-419f-9a76-c912d897afd7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/94634693-d94a-419f-9a76-c912d897afd7"
    }
  }
}
