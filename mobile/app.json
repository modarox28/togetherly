{
  "expo": {
    "name": "Togetherly",
    "slug": "togetherly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "togetherly",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.togetherly.app"
    },
    "android": {
      "package": "com.togetherly.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D1A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "autolinking": {
      "exclude": ["react-native-reanimated"]
    }
  }
}
