# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local a GitHub.
# En producción, estas mismas variables van en Vercel (web) y en Render (servidor de salas).

# ── Web (Vercel) ───────────────────────────────────────────────
# Base de datos Neon PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Inicio de sesión (Auth.js). AUTH_SECRET se genera con: npx auth secret
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección del servidor de salas (Render en producción, p. ej. https://togetherly-salas.onrender.com)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Pagos con Stripe (opcional: sin estas variables la web funciona y los pagos responden "no disponible")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Pase de sala Premium: el MISMO valor en Vercel y en Render (32+ caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_PASS_SECRET=

# ── Servidor de salas (Render; ver render.yaml) ────────────────
SOCKET_PORT=3001
# Dominios que pueden conectarse, separados por coma
ALLOWED_ORIGINS=http://localhost:3000
# ROOM_PASS_SECRET= (el mismo de arriba)
